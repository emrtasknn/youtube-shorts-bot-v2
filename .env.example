APP_NAME=youtube-shorts-bot-v2
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5432/shorts

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=27

PEXELS_ENABLED=true
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com
PEXELS_TIMEOUT_SECONDS=30

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

FISH_AUDIO_ENABLED=true
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_FORMAT=mp3
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_TIMEOUT_SECONDS=120

# ---- Studio V3 (docs/STUDIO_V3.md) ----
STUDIO_DIR=storage/studio
STUDIO_RENDER_MODE=local
STUDIO_TTS=ema,fish
STUDIO_PIPER_MODEL_DIR=
STUDIO_LLM=groq,gemini
STUDIO_GEMINI_MODEL=gemini-2.5-flash
STUDIO_ALIGN_MODEL=base
LEGACY_INTELLIGENCE_ENABLED=false
STUDIO_GITHUB_REPO=emrtasknn/youtube-shorts-bot-v2
STUDIO_GITHUB_TOKEN=
STUDIO_GITHUB_WORKFLOW=studio-render.yml
STUDIO_GITHUB_REF=main
