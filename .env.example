APP_NAME=youtube-shorts-bot-v2
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+psycopg://shorts:shorts@localhost:5432/shorts
TELEGRAM_BOT_TOKEN=

PEXELS_ENABLED=true
PEXELS_API_KEY=
PEXELS_BASE_URL=https://api.pexels.com
PEXELS_TIMEOUT_SECONDS=30

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

FISH_AUDIO_ENABLED=true
FISH_AUDIO_API_KEY=
FISH_AUDIO_BASE_URL=https://api.fish.audio
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_FORMAT=mp3
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_TIMEOUT_SECONDS=120
